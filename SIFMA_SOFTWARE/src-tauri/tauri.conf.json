{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SIFMA Desktop",
  "version": "2.0.0",
  "identifier": "co.gov.sifma.desktop",
  "build": {
    "frontendDist": "../frontend",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SIFMA — Sistema Integral de Fenotipado y Monitoreo Agrícola",
        "width": 1366,
        "height": 850,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
