[Unit]
Description=Servicio de Captura Fotografica Autonoma SIFMA (Raspberry Pi 5)
After=local-fs.target time-sync.target
Wants=local-fs.target

[Service]
Type=simple
User=nodo1
WorkingDirectory=/home/nodo1/raspi_node
ExecStart=/usr/bin/python3 /home/nodo1/raspi_node/main_capture.py --daemon
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
